---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="footer">
	<p>
		&copy; {today.getFullYear()} {SITE_TITLE} ·
		<a href="/contacto">Contacto</a>
	</p>
</footer>

<style>
	.footer {
		padding: 2rem 1.25rem;
		text-align: center;
		border-top: 1px solid rgba(50, 75, 32, 0.08);
	}

	.footer p {
		margin: 0;
		font-size: 0.82rem;
		color: #9ca3af;
	}

	.footer a {
		color: #b64f36;
		text-decoration: none;
	}

	.footer a:hover {
		text-decoration: underline;
	}
</style>
