---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { slugFromCategory } from '../utils/categories';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, heroImage, category } = Astro.props;
const categoryHref = category ? `/categoria/${slugFromCategory(category)}/` : '/';
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article class="detail-page">
				{heroImage && <img src={heroImage} alt={title} class="detail-page__photo" />}

				{category && <p class="detail-tag">{category}</p>}
				<h1 class="detail-page__title">{title}</h1>
				{description && <p class="detail-desc">{description}</p>}

				<div class="detail-content">
					<slot />
				</div>

				<a href={categoryHref} class="detail-page__back">← Volver a {category ?? 'inicio'}</a>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.detail-tag {
		display: inline-block;
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.4px;
		color: #b64f36;
		margin: 0 0 0.5rem;
	}

	.detail-desc {
		color: #6b7280;
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0.5rem 0 1.25rem;
	}

	.detail-content :global(p) {
		line-height: 1.7;
		color: #374151;
		margin-bottom: 1rem;
		font-size: 0.95rem;
	}

	.detail-content :global(img) {
		width: 100%;
		border-radius: 8px;
		margin: 1rem 0;
	}
</style>
