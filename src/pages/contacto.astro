---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
	SITE_TITLE,
	CONTACT_EMAIL,
	CONTACT_WHATSAPP,
	CONTACT_INSTAGRAM,
	whatsappUrl,
	instagramUrl,
} from '../consts';

const hasWhatsApp = Boolean(CONTACT_WHATSAPP);
const hasEmail = Boolean(CONTACT_EMAIL);
const hasInstagram = Boolean(CONTACT_INSTAGRAM);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Contacto | ${SITE_TITLE}`}
			description="Escríbenos para pedir una pieza personalizada, placas para mascotas, llaveros o decoración 3D."
		/>
	</head>

	<body>
		<Header />

		<main>
			<div class="contact-page">
				<h1>Contacto</h1>
				<p class="intro">
					¿Te gustó algo del catálogo o tienes una idea a medida? Escríbenos y te
					respondemos lo antes posible.
				</p>

				<div class="options">
					{hasWhatsApp && (
						<a
							href={whatsappUrl()}
							class="option option-whatsapp"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="label">WhatsApp</span>
							<span class="hint">La forma más rápida de escribirnos</span>
						</a>
					)}

					{hasEmail && (
						<div class="option option-email">
							<span class="label">Correo</span>
							<a class="email-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
							<span class="hint">Si no se abre tu correo, copia la dirección arriba.</span>
						</div>
					)}

					{hasInstagram && (
						<a
							href={instagramUrl()}
							class="option"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="label">Instagram</span>
							<span class="hint">@{CONTACT_INSTIGRAM}</span>
						</a>
					)}

					{!hasWhatsApp && !hasEmail && !hasInstagram && (
						<p class="empty-msg">
							Pronto añadiremos nuestros datos de contacto aquí.
						</p>
					)}
				</div>

				<p class="note">
					Puedes contarnos qué producto viste, el nombre de tu mascota, colores o
					cualquier detalle que tengas en mente.
				</p>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.contact-page {
		width: 100%;
		max-width: 520px;
		margin: 0 auto;
		padding: 1.5rem clamp(1rem, 3vw, 1.5rem) 3rem;
	}

	h1 {
		font-family: 'Cormorant Garamond', serif;
		font-size: clamp(1.8rem, 5vw, 2.4rem);
		color: #324b20;
		margin: 0 0 0.75rem;
	}

	.intro {
		color: #6b7280;
		line-height: 1.7;
		margin: 0 0 1.75rem;
		font-size: 0.95rem;
	}

	.options {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.option {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem 1.15rem;
		background: white;
		border-radius: 12px;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(50, 75, 32, 0.1);
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.option:hover {
		border-color: rgba(50, 75, 32, 0.25);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
	}

	.option-whatsapp {
		background: #324b20;
		border-color: #324b20;
		color: white;
	}

	.option-whatsapp .hint {
		color: rgba(255, 255, 255, 0.85);
	}

	.option-email {
		gap: 0.35rem;
	}

	.email-link {
		color: #324b20;
		font-weight: 500;
		font-size: 0.95rem;
		word-break: break-all;
	}

	.label {
		font-weight: 600;
		font-size: 1rem;
	}

	.hint {
		font-size: 0.85rem;
		color: #9ca3af;
	}

	.note {
		margin: 1.75rem 0 0;
		font-size: 0.85rem;
		color: #9ca3af;
		line-height: 1.6;
	}
</style>
