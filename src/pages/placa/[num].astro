---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getPlacas } from '../../utils/placas';

export function getStaticPaths() {
	return getPlacas().map((item) => ({
		params: { num: item.num },
		props: { item },
	}));
}

const { item } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`${item.title} | ${SITE_TITLE}`}
			description={`${item.title} — placa personalizada`}
			image={item.image}
		/>
	</head>

	<body>
		<Header />

		<main>
			<div class="detail-page">
				<img src={item.image} alt={item.title} class="detail-page__photo" />
				<h1 class="detail-page__title">{item.title}</h1>
				<a href="/categoria/placas-para-mascotas/" class="detail-page__back">← Volver a Placas</a>
			</div>
		</main>

		<Footer />
	</body>
</html>
