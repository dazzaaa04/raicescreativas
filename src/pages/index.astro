---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { CATEGORIES } from '../utils/categories';
import { getLlaveros } from '../utils/llaveros';
import { getDecoTotalCount } from '../utils/deco';
import { getPlacas } from '../utils/placas';

const products = await getCollection('blog');

const categoriesWithCount = CATEGORIES.map((cat) => {
	let count = 0;

	if (cat.slug === 'llaveros') count = getLlaveros().length;
	else if (cat.slug === 'decoracion-3d') count = getDecoTotalCount();
	else if (cat.slug === 'placas-para-mascotas') count = getPlacas().length;
	else count = products.filter((p) => p.data.category === cat.title).length;

	return { ...cat, count };
});
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/raicescreativas.png" />
	</head>

	<body>
		<Header />

		<main>
			<div class="catalog">
				<div class="product-grid product-grid--categories">
					{categoriesWithCount.map((cat) => (
						<a
							href={`/categoria/${cat.slug}/`}
							class="category-card"
							style={`--accent: ${cat.color}`}
						>
							<div class="category-card__visual">
								{cat.cover && <img src={cat.cover} alt="" loading="lazy" />}
							</div>
							<div class="category-card__info">
								<h2 class="category-card__title">{cat.title}</h2>
								{cat.count > 0 && <span class="category-card__count">{cat.count} piezas</span>}
							</div>
						</a>
					))}
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
